###############################################################################
# Lab 0 settings. Copy to `.env` and edit. Everything here is read by
# docker-compose.yml; changes take effect on the next `.\lab.ps1 restart`.
###############################################################################

# --- Step 7 of the handout ---------------------------------------------------
# >>> REPLACE THIS with the number assigned to you on the course page. <<<
# On the lab LAN, leaving it at 0 means you will see your classmates' nodes
# and they will see yours. It is not optional.
ROS_DOMAIN_ID=0

# --- The Gazebo switch -------------------------------------------------------
#   1  Gazebo may start.            (needed for Tests 6 and 7)
#   0  `lab sim` / `lab gz` refuse to start, so nothing can silently spin up a
#      physics engine while you are driving the real arm.
# Toggle it for a running container without editing this file:
#   lab gazebo off        lab gazebo on        lab gazebo status
LAB_GAZEBO=1

# --- Where the GUI goes ------------------------------------------------------
#   auto  WSLg if available, otherwise the browser (VNC)     <- recommended
#   wslg  force WSLg: RViz/Gazebo as normal Windows windows
#   vnc   force browser display at http://localhost:6080/
#   x11   an X server you run yourself (VcXsrv/X410); set DISPLAY too
#   none  headless
DISPLAY_MODE=auto
VNC_RESOLUTION=1600x900

# --- Rendering ---------------------------------------------------------------
# Docker Desktop gives the container no GPU, so Mesa's software rasteriser is
# the honest default (handout, Test 6). Set to 0 only if you wired up the
# optional GPU passthrough in docker-compose.yml.
LIBGL_ALWAYS_SOFTWARE=1

# --- Build -------------------------------------------------------------------
# Parallel compile jobs. 2 is the safe value from the handout's appendix;
# with 16 GB+ of RAM you can raise it to 4-6 to build faster.
COLCON_JOBS=2
# Branch/tag of xArm-Developer/xarm_ros2 baked into the image.
XARM_REF=jazzy

# --- The physical robot (Lab 1 onwards) --------------------------------------
# The control box IP is on the label on the base of the arm.
# `lab real` uses this when you do not pass an IP.
ROBOT_IP=

# --- DDS ---------------------------------------------------------------------
# Stock Jazzy default. rmw_cyclonedds_cpp is also installed if you ever need
# to rule out a Fast DDS problem.
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
