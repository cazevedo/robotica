#!/usr/bin/env bash
###############################################################################
# Give the container something to draw on.
#
#   DISPLAY_MODE=auto   use the host's X server if its socket is mounted,
#                       otherwise fall back to vnc. The right answer on Linux.
#   DISPLAY_MODE=x11    the X server already running on your Linux desktop.
#                       RViz and Gazebo open as ordinary windows, rendered by
#                       your own GPU. lab.sh mounts /tmp/.X11-unix and passes
#                       DISPLAY plus an auth cookie. Fastest, nicest.
#   DISPLAY_MODE=vnc    run a virtual X server inside the container and serve
#                       it at http://localhost:6080/ . Always works.
#   DISPLAY_MODE=wslg   Windows 11 + Docker Desktop (the windows branch).
#   DISPLAY_MODE=none   headless. No GUI at all.
#
# Writes the resolved DISPLAY to /tmp/.lab-display and the mode actually used
# to /tmp/.lab-display-mode so every `docker exec` shell picks up the same one.
###############################################################################
set -o pipefail

MODE="${DISPLAY_MODE:-auto}"
VNC_RESOLUTION="${VNC_RESOLUTION:-1600x900}"
VNC_DISPLAY="${VNC_DISPLAY:-:99}"

log() { echo "[display] $*"; }

# Is there a usable X socket for the DISPLAY we were handed? Checking for X0
# specifically is wrong on Linux: a normal GNOME session is often :1, and X0
# may not exist at all.
have_x11() {
    local d="${DISPLAY:-}"
    [ -n "${d}" ] || return 1
    case "${d}" in
        *:*) ;;                      # :1, :0.0, host:0 - fine
        *)   return 1 ;;
    esac
    local n="${d#*:}"; n="${n%%.*}"  # ":1.0" -> "1"
    [ -S "/tmp/.X11-unix/X${n}" ]
}

have_wslg() {
    # Docker Desktop bind-mounts the host's WSLg socket dir onto /tmp/.X11-unix.
    [ -S /tmp/.X11-unix/X0 ] && [ -d /mnt/wslg ]
}

start_vnc() {
    export DISPLAY="${VNC_DISPLAY}"

    if pgrep -f "Xvfb ${VNC_DISPLAY}" >/dev/null 2>&1; then
        log "VNC stack already running on ${VNC_DISPLAY}"
        return 0
    fi

    mkdir -p "${HOME}/.ros/log"
    local L="${HOME}/.ros/log/display.log"

    log "starting Xvfb ${VNC_DISPLAY} at ${VNC_RESOLUTION}"
    Xvfb "${VNC_DISPLAY}" -screen 0 "${VNC_RESOLUTION}x24" \
         +extension GLX +extension RANDR +render -noreset >>"${L}" 2>&1 &

    # wait for the X server to accept connections
    for _ in $(seq 1 50); do
        if xdpyinfo -display "${VNC_DISPLAY}" >/dev/null 2>&1; then break; fi
        sleep 0.2
    done
    if ! xdpyinfo -display "${VNC_DISPLAY}" >/dev/null 2>&1; then
        log "ERROR: Xvfb did not come up - see ${L}"
        return 1
    fi

    fluxbox -display "${VNC_DISPLAY}" >>"${L}" 2>&1 &
    x11vnc -display "${VNC_DISPLAY}" -forever -shared -nopw -rfbport 5900 \
           -noxdamage -quiet >>"${L}" 2>&1 &
    websockify --web=/usr/share/novnc 6080 localhost:5900 >>"${L}" 2>&1 &

    log "open http://localhost:6080/  (no password)"
    return 0
}

case "${MODE}" in
    auto)
        if have_wslg; then
            MODE=wslg
        elif have_x11; then
            MODE=x11
        else
            log "no X socket for DISPLAY='${DISPLAY:-unset}' - falling back to VNC"
            log "  (on Linux, start the container with ./lab.sh so it passes"
            log "   DISPLAY through and mounts /tmp/.X11-unix)"
            MODE=vnc
        fi
        ;;
esac

case "${MODE}" in
    wslg)
        export DISPLAY="${DISPLAY:-:0}"
        export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}"
        export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/mnt/wslg/runtime-dir}"
        [ -S /mnt/wslg/PulseServer ] && export PULSE_SERVER=/mnt/wslg/PulseServer
        if ! have_wslg; then
            log "WARNING: DISPLAY_MODE=wslg but /tmp/.X11-unix/X0 is missing."
            log "         GUI apps will fail. Try DISPLAY_MODE=vnc in .env"
        else
            log "using WSLg on ${DISPLAY} - windows appear on your Windows desktop"
        fi
        ;;
    vnc)
        start_vnc || exit 1
        ;;
    x11)
        # No default guess here: on Linux the host's DISPLAY is passed in, and
        # inventing host.docker.internal:0.0 would only mask a missing one.
        if [ -z "${DISPLAY:-}" ]; then
            log "WARNING: DISPLAY_MODE=x11 but DISPLAY is empty. Start the"
            log "         container with ./lab.sh, or set DISPLAY_MODE=vnc."
        elif have_x11; then
            log "using the host X server on ${DISPLAY} - windows open on your desktop"
        else
            log "WARNING: DISPLAY=${DISPLAY} but /tmp/.X11-unix has no matching"
            log "         socket. Is the host's X socket mounted? ./lab.sh does it."
        fi
        ;;
    none)
        unset DISPLAY
        log "headless (DISPLAY_MODE=none)"
        ;;
    *)
        log "unknown DISPLAY_MODE='${MODE}' - expected auto|wslg|vnc|x11|none"
        exit 1
        ;;
esac

echo "${DISPLAY:-}" > /tmp/.lab-display
echo "${MODE}"      > /tmp/.lab-display-mode
chmod 0666 /tmp/.lab-display /tmp/.lab-display-mode 2>/dev/null || true
exit 0
