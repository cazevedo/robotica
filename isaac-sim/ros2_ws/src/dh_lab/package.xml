<?xml version="1.0"?>
<?xml-stylesheet type="text/xsl" href="http://download.ros.org/schema/package_format3.xsd"?>
<package format="3">
  <name>dh_lab</name>
  <version>0.1.0</version>
  <description>
    Teaching tool for a 4th-year manipulator-kinematics course: students
    enter a Craig modified-DH table for the simulated uFactory Lite6 and
    check it against ground-truth forward kinematics computed independently
    from the robot's own description.
  </description>
  <maintainer email="cazevedo@ipn.pt">mariana.reis</maintainer>
  <license>TODO</license>

  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
