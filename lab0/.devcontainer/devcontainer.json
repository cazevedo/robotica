{
    "name": "Robotics lab (ROS 2 Jazzy + Lite 6)",
    "image": "robotica-lab:jazzy",
    "workspaceFolder": "/home/ros/dev_ws",
    "remoteUser": "ros",
    "runArgs": [
        "--network=host",
        "--ipc=host",
        "--name=robotica-lab-vscode"
    ],
    "containerEnv": {
        "DISPLAY": "${localEnv:DISPLAY}",
        "ROS_DOMAIN_ID": "${localEnv:ROS_DOMAIN_ID:0}",
        "ENABLE_GAZEBO": "1"
    },
    "mounts": [
        "source=${localWorkspaceFolder}/dev_ws,target=/home/ros/dev_ws,type=bind",
        "source=${localWorkspaceFolder}/.home,target=/home/ros/.persist,type=bind",
        "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind"
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-vscode.cpptools",
                "ms-iot.vscode-ros"
            ]
        }
    }
}
