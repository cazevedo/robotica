# Copy to .env (it is gitignored) and fill in your own values.
# run.sh reads this, so you do not have to pass the flags every time.

# The number assigned to you on the course page. Not optional on the lab LAN:
# with everybody on the default, your RViz finds your classmates' nodes.
ROS_DOMAIN_ID=0

# 1 = Gazebo available (default). 0 = don't launch it; lab-start falls back to
# the fake-controller stack. Per-shell override: ./run.sh --no-gazebo
ENABLE_GAZEBO=1

# The physical arm, from the label on its base. Only needed from Lab 1 on.
#ROBOT_IP=192.168.1.xxx

# colcon workers for image builds and lab-build. ~2 GB of RAM each. Changing
# this invalidates the cached xarm_ros2 build layer, so the next `run.sh build`
# recompiles the whole thing — set it once and leave it alone.
COLCON_JOBS=2
