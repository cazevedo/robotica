# RViz for the MoveIt-free back ends: the robot, its frames, and nothing else.
#
# Deliberately not xarm_moveit_config's moveit.rviz — that one drives a
# MotionPlanning display, which needs an SRDF and a move_group server, and
# without them it draws nothing and reports missing transforms.
#
# Fixed Frame is "world": the root of this robot's TF tree
# (world -> link_base -> link1..link6 -> link_eef).
Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /TF1
      Splitter Ratio: 0.5
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Name: root
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.25
      Plane Cell Count: 20
      Color: 160; 160; 164
      Alpha: 0.5
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 1
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Show Axes: true
      Show Arrows: false
      Marker Scale: 0.15
      Update Interval: 0
      Frame Timeout: 15
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: world
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 2.2
      Focal Point:
        X: 0
        Y: 0
        Z: 0.25
      Pitch: 0.45
      Yaw: 0.9
      Target Frame: <Fixed Frame>
    Saved: ~
Window Geometry:
  Height: 850
  Width: 1300
  Displays:
    collapsed: false
  Views:
    collapsed: false
